# Copy to .env and fill in. Never commit .env.

# --- Where the agents write their JSON (the dashboard reads from here) ---
# Default: ~/.openclaw/data
# DATA_DIR=/Users/you/.openclaw/data

# --- Email agent (Gmail API) ---
# From a Google Cloud OAuth "Desktop app" client (see agents/README.md):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Produced by `npm run auth:gmail` (one time):
GMAIL_REFRESH_TOKEN=

# --- Drive agent (Google Drive, reuses the Gmail OAuth app) ---
# Enable the Drive API in the same Google Cloud project, then run `npm run auth:drive`:
GDRIVE_REFRESH_TOKEN=

# --- News agent (RSS) ---
# Comma-separated feed URLs. Defaults to a general set if empty.
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.arstechnica.com/arstechnica/index
# Optional: only keep headlines matching these words (comma-separated). Empty = keep all.
NEWS_TOPICS=

# --- Weather agent (Open-Meteo, no API key) ---
WEATHER_LAT=-37.84
WEATHER_LON=144.95
WEATHER_LOCATION=Melbourne

# --- Calendar agent (iCal) ---
# Google Calendar → Settings → your calendar → "Secret address in iCal format"
CALENDAR_ICS_URL=

# --- Messages agent (bring your own source) ---
# A URL returning JSON (array or {items:[...]}), or a local JSON file a bridge keeps updated.
MESSAGES_URL=
MESSAGES_FILE=
