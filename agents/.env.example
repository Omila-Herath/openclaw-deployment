# Copy to .env and fill in. Never commit .env.

# --- Where the agents write their JSON (the dashboard reads from here) ---
# Default: ~/.openclaw/data
# DATA_DIR=/Users/you/.openclaw/data

# --- Email agent (Gmail API) ---
# From a Google Cloud OAuth "Desktop app" client (see agents/README.md):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Produced by `npm run auth:gmail` (one time):
GMAIL_REFRESH_TOKEN=

# --- News agent (RSS) ---
# Comma-separated feed URLs. Defaults to a general set if empty.
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.arstechnica.com/arstechnica/index
# Optional: only keep headlines matching these words (comma-separated). Empty = keep all.
NEWS_TOPICS=
